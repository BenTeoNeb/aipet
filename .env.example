# Copy to .env and fill in. Never commit .env (the Raspberry Pi deploy copies it to the device).

# Default engines (config.toml): everything through OpenRouter — the only key needed.
OPEN_ROUTER_API=           # provider "openrouter" (stt, conversation, preparation, condensation, tts)

# Only for the other engines you may select in config.toml ([engines.*].provider):
# GOOGLE_CLOUD_PROJECT=your-project-id   # google-vertex / Google Cloud engines (with gcloud ADC)
# GOOGLE_API_KEY=        # provider "google" (AI Studio)
# ANTHROPIC_API_KEY=     # provider "anthropic"
# OPENAI_API_KEY=        # provider "openai" (or set key_env to another variable, e.g. MISTRAL_API_KEY)
# ELEVENLABS_API_KEY=    # tts provider "elevenlabs"

# Optional overrides (PET_* variables; the older FLOCON_* names are still read)
# PET_CHARACTER=flocon                         # which pet (a folder in characters/)
# PET_CONVERSATION_MODEL=google/gemini-3.8-flash   # PET_<STT|CONVERSATION|PREPARATION|CONDENSATION|TTS>_<PROVIDER|MODEL>
# PET_HOME=~/.aipet                            # all data; one folder per pet in pets/<id>/
# PET_MEMORY_DIR=~/elsewhere/memory            # this pet's memory only
# PET_SKILLS_DIR=~/.aipet/skills               # the family's own activities
# PET_CONFIG=/path/to/config.toml
# PET_DEAF=1                                   # headless: don't listen while the pet speaks
# PET_NO_SLEEP=1                               # development: no night sleep and no naps (never in a deployed .env)
